# Copie para .env e preencha com os valores reais:
#   cp .env.example .env
# Nunca coloque senhas reais neste arquivo (ele vai para o GitHub).

# Ambiente: development, test ou production
APP_ENV=development

# Usadas pelo Docker Compose para criar o banco e pela API/Alembic para conectar
POSTGRES_USER=saudevigia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=saudevigia

# Onde a API/Alembic acham o banco quando rodam FORA do Docker (venv).
# Dentro do Docker, o compose.yaml troca para db:5432.
# 127.0.0.1 em vez de localhost: no Windows, localhost tenta IPv6 (::1) primeiro e trava
DB_HOST=127.0.0.1
DB_PORT=5433

# SSL na conexão com o banco: prefer no local, require em produção (Neon)
DB_SSLMODE=prefer

# Airflow: segredos usados pelos contêineres do Airflow (compose.yaml)
# Fernet key criptografa as senhas das conexões guardadas no Airflow. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Assina os tokens de login da API do Airflow. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Gemini (Google AI Studio): chave da API do LLM.
# Criar em aistudio.google.com > Get API key. Plano grátis: não ativar billing.
GOOGLE_API_KEY=
