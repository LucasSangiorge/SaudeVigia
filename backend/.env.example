# Copie para .env e preencha com os valores reais:
#   cp .env.example .env
# Nunca coloque senhas reais neste arquivo (ele vai para o GitHub).

# Ambiente: development, test ou production
APP_ENV=development

# Usadas pelo Docker Compose para criar o banco local
POSTGRES_USER=saudevigia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=saudevigia

# Usada pela API e pelo Alembic (mesmos usuário, senha e banco de cima)
# 127.0.0.1 em vez de localhost: no Windows, localhost tenta IPv6 (::1) primeiro e trava
DATABASE_URL=postgresql+psycopg://saudevigia:troque-esta-senha@127.0.0.1:5433/saudevigia


